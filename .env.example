# Copy to .env and fill in. Never commit your real .env.

# The subdomain pointing at this server. Caddy gets a Let's Encrypt cert for it.
CHECKIN_DOMAIN=your-domain.example.com

# Friendly name shown in the app.
CHECKIN_SERVER_NAME=Check-In

# Default phone country calling code applied to bare national numbers so contacts saved
# as "+1 (415) 555-0148" match a friend who types "(415) 555-0148". Default "1" (US/
# Canada). Set to your code (e.g. "44" UK, "61" AU). Numbers entered with a leading +
# are always taken as-is.
# CHECKIN_DEFAULT_COUNTRY_CODE=1

# Database credentials (used by both Postgres and the server connection string).
POSTGRES_USER=checkin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=checkin

# Optional: pin a specific released image instead of :latest
# CHECKIN_IMAGE=ghcr.io/nc1107/check-in:v1.0.0

# Optional: enable the /debug maintenance web view (stats, member phone numbers, and a
# destructive "reset to first-login" DB wipe). Leave blank to disable entirely. When set,
# visit https://<domain>/debug?token=<this value>. Generate with: openssl rand -base64 32
# CHECKIN_DEBUG_TOKEN=

# Optional (multi-group installs): your Play App Signing SHA-256 cert fingerprint, used
# by scripts/gen-stack.sh to render .well-known/assetlinks.json for Android App Links
# (Play Console → Test and release → App integrity). See docs/self-hosting/multiple-groups.md.
# ANDROID_CERT_SHA256=

# Optional: push notifications via Firebase Cloud Messaging (reaches Android directly and
# iOS through APNs). Leave both unset to disable push; everything else works without it.
#
# READ THIS FIRST: setting these two variables does NOT give you push if your members use
# the Check-In app from the App Store or Google Play. Those builds mint their device tokens
# against the maintainer's Firebase project, and FCM refuses to deliver to a token minted
# against a different project than the credentials belong to. Every send fails with
# SENDER_ID_MISMATCH while the server looks perfectly healthy.
#
# The two variables below only work if you build and distribute the app yourself with your
# own Firebase config compiled into it (on iOS: your own Apple Developer account and App
# Review). A hosted relay is planned for hosts who want push with the published apps.
# All three options are spelled out in docs/self-hosting/configuration.md#push-notifications
# - read that before filling these in.
# CHECKIN_FCM_CREDENTIALS_HOST=./fcm-service-account.json
# CHECKIN_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
