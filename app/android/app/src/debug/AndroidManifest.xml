<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only. Pointing the app at a dev server on http://10.0.2.2:8080 needs
         cleartext, but what ships must not have it: docs/self-hosting/security.md requires
         HTTPS and tells hosts not to serve over plain HTTP. Declaring it here keeps the
         release manifest on the platform default, which refuses cleartext from API 28 up.
    -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
