# Secrets / local config
.env
*.env.local

# Multi-group registry (per-group debug tokens) and its generated artifacts.
# Keep groups/example.env.sample; re-render the rest with scripts/gen-stack.sh.
groups/*.env
docker-compose.generated.yml
Caddyfile.generated

# Server
server/data/
server/server
server/check-in-server*
*.out

# Gazetteer dataset: fetched and packed from a pinned GeoNames URL at Docker build time
# (server/internal/gazetteer/data/fetch_and_pack.sh) or locally on demand - never committed
# to the repo at all (see server/internal/gazetteer/data/SOURCE.md for why). ~180MB.
server/internal/gazetteer/data/places.bin
__pycache__/

# Credentials — defense-in-depth; these must never be committed. (The committed
# google-services.json / GoogleService-Info.plist are client config, not secrets,
# and don't match these patterns.)
*service-account*.json
fcm-*.json
*.p8
AuthKey_*.p8

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.idea/
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/**/*.g.dart
app/**/*.freezed.dart
*.keystore
*.jks
*.p12
*.mobileprovision

# OS / editor
.DS_Store
*.swp
.vscode/

# Tooling / session data
.claude/
.playwright-mcp/
downloads/
