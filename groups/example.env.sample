# One file per friend group. Copy to <slug>.env (e.g. alpha.env) — or better, let
# scripts/new-group.sh create it for you.
#
# The slug becomes the subdomain (<slug>.$CHECKIN_DOMAIN), the compose service name
# (server-<slug>), the database name (checkin_<slug>), and the media volume
# (media_<slug>). Lowercase letters, digits, and hyphens only; must not be "main".
SLUG=example

# Friendly name shown in the app for this group.
DISPLAY_NAME="Example Crew"

# Per-group /debug token (optional; blank disables the debug view for this group).
# Generate with: openssl rand -hex 24
CHECKIN_DEBUG_TOKEN=
